{%- if product != blank -%}
  {{ 'section-sticky-atc.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'sticky-atc.js' | asset_url }}" defer="defer"></script>

  {%- assign current_variant = product.selected_or_first_available_variant -%}

  {%- style -%}
    #StickyAtc-{{ section.id }} {
      --sticky-bg: {{ section.settings.bg_color }};
      --sticky-text: {{ section.settings.text_color }};
      --sticky-btn-bg: {{ section.settings.button_bg_color }};
      --sticky-btn-text: {{ section.settings.button_text_color }};
    }
  {%- endstyle -%}

  <sticky-atc
    id="StickyAtc-{{ section.id }}"
    class="sticky-atc{% if section.settings.show_on_desktop %} sticky-atc--desktop-visible{% endif %}"
    aria-hidden="true"
  >
    <div class="sticky-atc__inner page-width">
      <div class="sticky-atc__product">
        {%- if section.settings.show_thumbnail and product.featured_media != blank -%}
          <img
            src="{{ product.featured_media | image_url: width: 96 }}"
            alt="{{ product.featured_media.alt | default: product.title | escape }}"
            width="48"
            height="48"
            loading="lazy"
            class="sticky-atc__thumb"
          >
        {%- endif -%}

        <div class="sticky-atc__info">
          <p class="sticky-atc__title">{{ product.title | escape }}</p>
          <p class="sticky-atc__price" data-sticky-price>
            {{ current_variant.price | money }}
          </p>
        </div>
      </div>

      <button
        type="button"
        class="sticky-atc__button"
        data-sticky-submit
        {% unless current_variant.available %}disabled{% endunless %}
      >
        {%- if current_variant.available -%}
          {{ section.settings.button_label | escape }}
        {%- else -%}
          {{ 'products.product.sold_out' | t }}
        {%- endif -%}
      </button>
    </div>
  </sticky-atc>
{%- endif -%}

{% schema %}
{
  "name": "Sticky Add-to-Cart",
  "tag": "div",
  "class": "section-sticky-atc",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Add to cart"
    },
    {
      "type": "checkbox",
      "id": "show_thumbnail",
      "label": "Show product thumbnail",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_on_desktop",
      "label": "Also show on desktop screens",
      "default": false
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Bar background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button background",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "Sticky Add-to-Cart"
    }
  ]
}
{% endschema %}